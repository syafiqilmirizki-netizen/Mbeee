<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>🎯 Tic Tac Toe - Lawan Komputer</title>
<style>
  /* --- Root variables for neon style & responsive sizing --- */
  :root{
    --bg1: #070717;
    --bg2: #0f1226;
    --neon-blue: #3ee0ff;
    --neon-purple: #aa69ff;
    --glass: rgba(255,255,255,0.03);
    --accent: linear-gradient(135deg,var(--neon-blue),var(--neon-purple));
    --board-size: min(70vmin, 480px);
    --cell-gap: min(2vmin, 12px);
    --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  }

  /* --- Page layout --- */
  *{box-sizing:border-box}
  html,body{height:100%}
  body{
    margin:0;
    padding:clamp(12px,4vmin,28px);
    background: radial-gradient(1200px 600px at 10% 10%, rgba(58,40,120,0.25), transparent),
                radial-gradient(900px 500px at 90% 90%, rgba(20,60,120,0.18), transparent),
                linear-gradient(180deg,var(--bg1),var(--bg2));
    color: #e6eefb;
    font-family:var(--font-sans);
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:100vh;
    gap:20px;
  }

  /* --- Card container --- */
  .card{
    width:100%;
    max-width:900px;
    background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    border-radius:18px;
    padding:clamp(16px,2.5vmin,26px);
    box-shadow: 0 10px 40px rgba(10,10,30,0.5), 0 0 30px rgba(80,40,200,0.06) inset;
    border: 1px solid rgba(255,255,255,0.04);
    display:grid;
    grid-template-columns: 1fr 340px;
    gap:20px;
  }

  /* Make single-column on small screens */
  @media (max-width:820px){
    .card{grid-template-columns:1fr}
  }

  /* --- Header --- */
  header{
    grid-column:1/-1;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
  }
  h1{
    margin:0;
    font-size:clamp(18px,3.2vmin,28px);
    display:flex;
    align-items:center;
    gap:12px;
    letter-spacing:0.4px;
    text-shadow: 0 0 12px rgba(170,105,255,0.12), 0 0 6px rgba(62,224,255,0.06);
  }

  /* Sound toggle */
  .sound-toggle{
    display:flex;
    gap:8px;
    align-items:center;
  }
  .icon-btn{
    width:44px;
    height:44px;
    display:grid;
    place-items:center;
    border-radius:10px;
    background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    border:1px solid rgba(255,255,255,0.03);
    cursor:pointer;
    transition:transform .12s ease, box-shadow .12s ease;
    user-select:none;
  }
  .icon-btn:active{transform:scale(.96)}
  .icon-btn.on{
    box-shadow: 0 6px 18px rgba(102,51,255,0.18), 0 0 24px rgba(62,224,255,0.06);
    background: var(--accent);
    color:#04121a;
    mix-blend-mode:screen;
  }

  /* --- Playground --- */
  .playground{
    display:flex;
    gap:20px;
    align-items:flex-start;
    justify-content:center;
    width:100%;
  }

  /* Board column */
  .board-wrap{
    width:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:12px;
  }

  /* Board (responsive using --board-size) */
  .board{
    width:var(--board-size);
    height:var(--board-size);
    display:grid;
    grid-template-columns:repeat(3,1fr);
    grid-template-rows:repeat(3,1fr);
    gap:var(--cell-gap);
    padding:var(--cell-gap);
    border-radius:18px;
    background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    box-shadow: 0 6px 30px rgba(0,0,0,0.45), 0 0 40px rgba(70,20,160,0.06) inset;
    border: 1px solid rgba(255,255,255,0.03);
    touch-action: manipulation;
  }

  /* Each cell */
  .cell{
    border-radius:12px;
    display:grid;
    place-items:center;
    font-size: calc(var(--board-size) / 6);
    font-weight:700;
    color: rgba(230,238,251,0.95);
    background: linear-gradient(180deg, rgba(255,255,255,0.007), rgba(255,255,255,0.01));
    cursor:pointer;
    user-select:none;
    transition: transform .12s ease, box-shadow .18s ease, background .18s ease;
    position:relative;
    -webkit-tap-highlight-color: transparent;
  }
  .cell:active{transform:scale(.98)}
  .cell .mark{
    pointer-events:none;
    transform: scale(0.86);
    transition: transform .22s cubic-bezier(.2,.9,.3,1), opacity .18s;
    text-shadow: 0 0 18px rgba(170,105,255,0.12);
  }
  .cell.played{cursor:default; opacity:0.98}
  .cell:hover:not(.played){
    box-shadow: 0 6px 20px rgba(60,20,140,0.12);
    transform: translateY(-4px);
  }

  /* Marks styling for X and O */
  .mark.x{
    color: var(--neon-blue);
    filter: drop-shadow(0 6px 20px rgba(62,224,255,0.08));
  }
  .mark.o{
    color: var(--neon-purple);
    filter: drop-shadow(0 6px 20px rgba(170,105,255,0.08));
  }

  /* Smooth show */
  .mark.show{ transform: scale(1); opacity:1 }

  /* Side panel */
  .side{
    width:100%;
    max-width:340px;
    display:flex;
    flex-direction:column;
    gap:12px;
    align-items:stretch;
  }
  .panel{
    padding:14px;
    border-radius:12px;
    background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.007));
    border:1px solid rgba(255,255,255,0.03);
  }
  .status{
    font-size:clamp(14px,2.4vmin,18px);
    font-weight:700;
    text-align:center;
    padding:10px;
    border-radius:10px;
    background: linear-gradient(90deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005));
    box-shadow: inset 0 -6px 20px rgba(0,0,0,0.25);
    position:relative;
    overflow:hidden;
  }
  .status .msg{
    opacity:0;
    transform: translateY(8px);
    transition: all .35s cubic-bezier(.2,.9,.3,1);
    display:block;
    color: #eaf7ff;
  }
  .status.show .msg{opacity:1; transform:none}

  /* Buttons */
  .controls{
    display:flex;
    gap:10px;
    align-items:center;
    justify-content:center;
    margin-top:8px;
  }
  button.btn{
    padding:10px 14px;
    background:transparent;
    border:1px solid rgba(255,255,255,0.06);
    border-radius:10px;
    cursor:pointer;
    font-weight:700;
    letter-spacing:0.3px;
    min-width:110px;
    transition: all .14s ease;
  }
  button.btn.primary{
    background:var(--accent);
    color:#04121a;
    box-shadow: 0 6px 24px rgba(170,105,255,0.12);
    border: none;
  }
  button.btn:active{transform:scale(.98)}

  /* Winner effect - glowing overlay for winning cells */
  .winner {
    animation: winner-glow .9s ease forwards;
  }
  @keyframes winner-glow {
    0% { box-shadow: 0 0 0 rgba(255,255,255,0);}
    30% { box-shadow: 0 0 18px rgba(170,105,255,0.18);}
    60% { box-shadow: 0 0 36px rgba(62,224,255,0.18);}
    100% { box-shadow: 0 0 64px rgba(170,105,255,0.25); transform: scale(1.03); }
  }

  /* Overlay for result (fade in/out) */
  .result{
    pointer-events:none;
    position:absolute;
    inset:0;
    display:grid;
    place-items:center;
    z-index:4;
    opacity:0;
    transition:opacity .28s ease;
  }
  .result.show{ opacity:1; pointer-events:auto; }

  .result-card{
    min-width:220px;
    background: linear-gradient(90deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
    border-radius:12px;
    padding:18px;
    text-align:center;
    box-shadow: 0 18px 60px rgba(0,0,0,0.55);
    border:1px solid rgba(255,255,255,0.03);
    transform: translateY(20px);
    transition: transform .36s cubic-bezier(.2,.9,.3,1);
  }
  .result.show .result-card{ transform:none }
  .result h2{ margin:0 0 8px; font-size:clamp(18px,3vmin,22px);}
  .sparkle{
    height:8px;
    width:100%;
    border-radius:6px;
    background: radial-gradient(circle at 30% 30%, rgba(62,224,255,0.8), transparent 15%),
                radial-gradient(circle at 70% 70%, rgba(170,105,255,0.75), transparent 12%);
    filter: blur(6px);
    margin-bottom:10px;
    opacity:0.95;
  }

  /* small footnote */
  .muted{opacity:0.7; font-size:13px; text-align:center}
</style>
</head>
<body>
  <div class="card" role="application" aria-label="Tic Tac Toe Game">
    <header>
      <h1>🎯 Tic Tac Toe - Lawan Komputer</h1>
      <div class="sound-toggle" aria-hidden="false">
        <div id="musicBtn" class="icon-btn" title="Toggle music" role="button" tabindex="0" aria-label="Toggle music">🔊</div>
        <div id="muteBtn" class="icon-btn" title="Toggle sound effects" role="button" tabindex="0" aria-label="Toggle sound effects">🔈</div>
      </div>
    </header>

    <main class="playground" aria-live="polite">
      <!-- Board Column -->
      <section class="board-wrap">
        <div class="board" id="board" aria-label="Papan permainan tic tac toe" role="grid">
          <!-- 9 cells injected by JS for clarity -->
        </div>

        <div style="display:flex; gap:12px; align-items:center; margin-top:6px;">
          <button id="restartBtn" class="btn" aria-label="Mulai ulang permainan">Reset</button>
          <button id="rematchBtn" class="btn primary" style="display:none" aria-label="Main lagi">Main Lagi</button>
        </div>

        <p style="margin-top:10px; text-align:center" class="muted">Klik sebuah kotak untuk meletakkan X. Komputer akan bermain O.</p>
      </section>

      <!-- Side Panel -->
      <aside class="side">
        <div class="panel">
          <div class="status" id="status">
            <span class="msg" id="statusMsg">Giliranmu — X</span>
          </div>
          <div class="controls" style="margin-top:12px;">
            <button id="youBtn" class="btn">Kamu (X)</button>
            <button id="aiBtn" class="btn">Komputer (O)</button>
          </div>
        </div>

        <div class="panel">
          <div style="font-weight:700; margin-bottom:8px">Aturan & Tips</div>
          <ul style="margin:0; padding-left:18px">
            <li>3x3, tiga berurutan menang.</li>
            <li>AI memakai strategi optimal (minimax sederhana).</li>
            <li>Responsive: coba ubah ukuran jendela atau buka di ponsel.</li>
          </ul>
        </div>
      </aside>

      <!-- Result overlay -->
      <div class="result" id="result" aria-hidden="true">
        <div class="result-card" role="status">
          <div class="sparkle" id="sparkle"></div>
          <h2 id="resultText">Kamu Menang!</h2>
          <p id="resultSub" class="muted">Selamat! Tekan "Main Lagi" untuk bermain lagi.</p>
        </div>
      </div>
    </main>
  </div>

<script>
/* -----------------------
   Tic Tac Toe - Single file
   - Vanilla JS
   - Minimax AI
   - WebAudio for clicks, win sound, and background pad (toggleable)
   - Responsive sizing & animations
   ------------------------*/

/* ------- Game state & constants ------- */
const HUMAN = 'X';      // player's mark
const AI = 'O';         // ai's mark
let board = Array(9).fill(null); // 0..8
let isHumanTurn = true;
let gameOver = false;
let cellElements = [];
const winLines = [
  [0,1,2],[3,4,5],[6,7,8], // rows
  [0,3,6],[1,4,7],[2,5,8], // cols
  [0,4,8],[2,4,6]          // diags
];

/* ------- UI references ------- */
const boardEl = document.getElementById('board');
const statusMsg = document.getElementById('statusMsg');
const statusWrap = document.getElementById('status');
const resultWrap = document.getElementById('result');
const resultText = document.getElementById('resultText');
const rematchBtn = document.getElementById('rematchBtn');
const restartBtn = document.getElementById('restartBtn');
const musicBtn = document.getElementById('musicBtn');
const muteBtn = document.getElementById('muteBtn');
const youBtn = document.getElementById('youBtn');
const aiBtn = document.getElementById('aiBtn');

/* ------- Audio (WebAudio) ------- */
let audioCtx = null;
let bgGain = null;
let bgOsc = null;
let musicOn = false;
let sfxOn = true;

/* Initialize board cells (DOM) */
function createBoardUI(){
  boardEl.innerHTML = '';
  cellElements = [];
  for(let i=0;i<9;i++){
    const cell = document.createElement('div');
    cell.className = 'cell';
    cell.setAttribute('role','button');
    cell.setAttribute('aria-label', 'Kotak ' + (i+1));
    cell.dataset.index = i;
    cell.addEventListener('click', onCellClick);
    // mark container
    const mark = document.createElement('div');
    mark.className = 'mark';
    mark.style.opacity = 0;
    cell.appendChild(mark);
    boardEl.appendChild(cell);
    cellElements.push(cell);
  }
}

/* --- Render board marks --- */
function render(){
  for(let i=0;i<9;i++){
    const markEl = cellElements[i].querySelector('.mark');
    const val = board[i];
    markEl.textContent = val ? val : '';
    markEl.className = 'mark' + (val ? ' show ' + (val==='X' ? 'x' : 'o') : '');
    if(val) cellElements[i].classList.add('played'); else cellElements[i].classList.remove('played','winner');
  }
}

/* --- Handle cell click --- */
function onCellClick(e){
  if(gameOver) return;
  const idx = Number(e.currentTarget.dataset.index);
  if(board[idx]) return;
  if(!isHumanTurn) return;
  playSound('click');
  makeMove(idx, HUMAN);
}

/* --- Make move for a player, check result, then continue --- */
function makeMove(idx, player){
  if(board[idx] || gameOver) return;
  board[idx] = player;
  render();
  const {winner, line} = checkWinner(board);
  if(winner){
    finishGame(winner, line);
    return;
  }
  if(isBoardFull(board)){
    finishGame(null, null); // draw
    return;
  }
  isHumanTurn = (player !== HUMAN); // toggle appropriate because human just moved OR AI just moved
  updateStatus();
  // if next is AI, let AI calculate & play after small delay for UX
  if(!isHumanTurn && !gameOver){
    setTimeout(() => {
      const aiMove = computeBestMove(board);
      playSound('click');
      makeMove(aiMove, AI);
    }, 340); // short animation gap
  }
}

/* --- Update status text --- */
function updateStatus(){
  if(gameOver) return;
  if(isHumanTurn){
    statusMsg.textContent = "Giliranmu — X";
  } else {
    statusMsg.textContent = "Giliran Komputer — O";
  }
  statusWrap.classList.add('show');
}

/* --- Finish: show winning animation and result --- */
function finishGame(winner, line){
  gameOver = true;
  // highlight winning line
  if(line){
    line.forEach(i => {
      const cell = cellElements[i];
      cell.classList.add('winner');
    });
  }
  // result text and sounds
  if(winner === HUMAN){
    resultText.textContent = "Kamu Menang!";
    playSound('win');
  } else if(winner === AI){
    resultText.textContent = "Komputer Menang!";
    playSound('lose');
  } else {
    resultText.textContent = "Seri!";
    playSound('draw');
  }
  showResult();
  // expose rematch button
  rematchBtn.style.display = 'inline-block';
}

/* --- Show overlay result with animation --- */
function showResult(){
  resultWrap.classList.add('show');
  resultWrap.setAttribute('aria-hidden','false');
}

/* --- Utility: check for winner --- */
function checkWinner(bd){
  for(const line of winLines){
    const [a,b,c] = line;
    if(bd[a] && bd[a] === bd[b] && bd[a] === bd[c]){
      return { winner: bd[a], line };
    }
  }
  return { winner: null, line: null };
}
function isBoardFull(bd){ return bd.every(Boolean); }

/* -------------------------
   Minimax AI (optimal)
   Small board => performance fine
   -------------------------*/
function computeBestMove(bd){
  // if immediate win or block available, that will be found by minimax anyway
  const best = minimax(bd, AI);
  return best.index;
}

function minimax(newBoard, player){
  // available spots
  const avail = newBoard.map((v,i)=> v ? null : i).filter(v => v !== null);

  // check terminal states
  const check = checkWinner(newBoard);
  if(check.winner === HUMAN) return {score: -10};
  if(check.winner === AI) return {score: 10};
  if(avail.length === 0) return {score: 0};

  const moves = [];
  for(const i of avail){
    const move = {};
    move.index = i;
    newBoard[i] = player;

    if(player === AI){
      const result = minimax(newBoard, HUMAN);
      move.score = result.score;
    } else {
      const result = minimax(newBoard, AI);
      move.score = result.score;
    }
    // undo
    newBoard[i] = null;
    moves.push(move);
  }

  // choose best
  let bestMove;
  if(player === AI){
    let bestScore = -Infinity;
    for(const m of moves){
      if(m.score > bestScore){
        bestScore = m.score;
        bestMove = m;
      }
    }
  } else {
    let bestScore = Infinity;
    for(const m of moves){
      if(m.score < bestScore){
        bestScore = m.score;
        bestMove = m;
      }
    }
  }
  return bestMove;
}

/* ------- Controls & event binding ------- */
function resetGame(startHuman=true){
  board = Array(9).fill(null);
  isHumanTurn = startHuman;
  gameOver = false;
  render();
  resultWrap.classList.remove('show');
  resultWrap.setAttribute('aria-hidden','true');
  rematchBtn.style.display = 'none';
  updateStatus();
  // if AI goes first
  if(!isHumanTurn){
    setTimeout(()=> {
      const aiMove = computeBestMove(board);
      makeMove(aiMove, AI);
    }, 350);
  }
}

/* Bind UI */
rematchBtn.addEventListener('click', ()=> resetGame(true));
restartBtn.addEventListener('click', ()=> resetGame(true));

youBtn.addEventListener('click', ()=> {
  // let human be X (default)
  youBtn.classList.add('primary');
  aiBtn.classList.remove('primary');
  resetGame(true);
});
aiBtn.addEventListener('click', ()=> {
  // let AI be X and go first? but requirement says player is X -> keep as UI that AI plays O, but allow quick toggle for visuals
  aiBtn.classList.add('primary');
  youBtn.classList.remove('primary');
  // start with human true for consistent rules
  resetGame(true);
});

/* Sound toggles */
musicBtn.addEventListener('click', toggleMusic);
musicBtn.addEventListener('keydown', (e)=> { if(e.key==='Enter') toggleMusic(); });
muteBtn.addEventListener('click', toggleSfx);
muteBtn.addEventListener('keydown', (e)=> { if(e.key==='Enter') toggleSfx(); });

/* Initialize UI on load */
createBoardUI();
render();
updateStatus();

/* If desired, auto-start music attempt (may be blocked by browser) */
function ensureAudioContext(){
  if(!audioCtx){
    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  }
}

/* --- Background music: gentle pad using oscillator & LFO --- */
function startBackgroundMusic(){
  ensureAudioContext();
  if(bgOsc) return;
  // ambient pad: two oscillators + smooth gain
  bgGain = audioCtx.createGain();
  bgGain.gain.value = 0.05; // low volume
  bgGain.connect(audioCtx.destination);

  // slow LFO on frequency for movement
  const lfo = audioCtx.createOscillator();
  lfo.type = 'sine';
  lfo.frequency.value = 0.08; // slow
  const lfoGain = audioCtx.createGain();
  lfoGain.gain.value = 40; // modulation depth
  lfo.connect(lfoGain);

  // main oscillator
  bgOsc = audioCtx.createOscillator();
  bgOsc.type = 'sine';
  bgOsc.frequency.value = 220; // base tone

  // connect lfo to detune via gain (works as slow wobble)
  lfoGain.connect(bgOsc.frequency);
  bgOsc.connect(bgGain);

  // simple reverb-like feel with second oscillator detuned
  const bgOsc2 = audioCtx.createOscillator();
  bgOsc2.type = 'sine';
  bgOsc2.frequency.value = 220 * 1.498; // harmonic
  bgOsc2.detune.value = -12;
  const g2 = audioCtx.createGain();
  g2.gain.value = 0.02;
  bgOsc2.connect(g2);
  g2.connect(bgGain);

  lfo.start();
  bgOsc.start();
  bgOsc2.start();
  // save refs for stop
  bgOsc._lfo = lfo;
  bgOsc._osc2 = bgOsc2;
}

function stopBackgroundMusic(){
  if(!bgOsc) return;
  try{
    bgOsc._lfo && bgOsc._lfo.stop();
    bgOsc._osc2 && bgOsc._osc2.stop();
    bgOsc.stop();
  }catch(e){ /*ignore*/ }
  bgOsc = null;
  bgGain = null;
}

/* --- SFX: click, win, lose, draw using simple oscillator bursts --- */
function playSound(type){
  if(!sfxOn) return;
  ensureAudioContext();
  // short bursts
  const t = audioCtx.currentTime;
  const g = audioCtx.createGain();
  g.gain.value = 0.0001;
  g.connect(audioCtx.destination);

  if(type === 'click'){
    const o = audioCtx.createOscillator();
    o.type = 'square';
    o.frequency.value = 1200;
    o.connect(g);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.04, t+0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, t+0.18);
    o.start(t);
    o.stop(t+0.2);
  } else if(type === 'win'){
    // arpeggio
    const freqs = [520, 660, 880];
    freqs.forEach((f,i)=>{
      const o = audioCtx.createOscillator();
      const gg = audioCtx.createGain();
      o.type = 'sine';
      o.frequency.value = f;
      o.connect(gg);
      gg.connect(audioCtx.destination);
      gg.gain.setValueAtTime(0.0001, t + i*0.06);
      gg.gain.exponentialRampToValueAtTime(0.08, t + i*0.06 + 0.02);
      gg.gain.exponentialRampToValueAtTime(0.0001, t + i*0.06 + 0.26);
      o.start(t + i*0.06);
      o.stop(t + i*0.06 + 0.28);
    });
  } else if(type === 'lose'){
    const o = audioCtx.createOscillator();
    o.type = 'sawtooth';
    o.frequency.value = 220;
    o.connect(g);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.06, t+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t+0.6);
    o.start(t);
    o.stop(t+0.7);
  } else if(type === 'draw'){
    const o = audioCtx.createOscillator();
    o.type = 'triangle';
    o.frequency.value = 400;
    o.connect(g);
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.045, t+0.02);
    g.gain.exponentialRampToValueAtTime(0.0001, t+0.4);
    o.start(t);
    o.stop(t+0.5);
  }
}

/* Toggle music */
function toggleMusic(){
  if(!musicOn){
    // start audio context and music
    ensureAudioContext();
    // some browsers require resume on user gesture
    audioCtx.resume && audioCtx.resume();
    startBackgroundMusic();
    musicOn = true;
    musicBtn.classList.add('on');
    musicBtn.textContent = '🎵';
  } else {
    stopBackgroundMusic();
    musicOn = false;
    musicBtn.classList.remove('on');
    musicBtn.textContent = '🔊';
  }
}

/* Toggle sfx */
function toggleSfx(){
  sfxOn = !sfxOn;
  if(sfxOn){
    muteBtn.classList.add('on');
    muteBtn.textContent = '🔈';
  }else{
    muteBtn.classList.remove('on');
    muteBtn.textContent = '🔇';
  }
}

/* Simple accessibility: allow keyboard to click cells */
boardEl.addEventListener('keydown', (e) => {
  if(e.key>=1 && e.key<=9){
    const idx = Number(e.key) - 1;
    const cell = cellElements[idx];
    if(cell) cell.click();
  }
});

/* Prevent accidental double-tap zoom on mobile (basic) */
document.addEventListener('touchstart', function(){}, {passive:true});

/* Try to start muted music softly (some browsers block autoplay). We won't force it. */
/* Optional: attempt small resume to allow play if this is considered user gesture */
window.addEventListener('load', ()=> {
  // prefer human start; but we can attempt to resume audio context if user interacted
  try{ if(audioCtx && audioCtx.state === 'suspended') audioCtx.resume(); }catch(e){}
});

/* init */
resetGame(true);

/* -------------------------
   Extra: if user clicks on overlay, hides it (so they can continue)
   -------------------------*/
resultWrap.addEventListener('click', ()=> {
  resultWrap.classList.remove('show');
  resultWrap.setAttribute('aria-hidden','true');
});

